{
  "name": "@kiskadee/json-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "inspect": "node scripts/inspect.ts",
    "dev": "pnpm inspect && next dev --hostname 127.0.0.1 --port 3002",
    "build": "pnpm inspect && next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "test": "vitest run",
    "typecheck": "pnpm inspect && next typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@kiskadee/core": "workspace:*",
    "@kiskadee/presets": "workspace:*",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  }
}
