{
  "name": "@kiskadee/react-headless",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/HeadlessTabs.d.ts",
      "import": "./dist/components/tabs/HeadlessTabs.js",
      "default": "./dist/components/tabs/HeadlessTabs.js"
    },
    "./button": {
      "types": "./dist/components/button/Button.d.ts",
      "import": "./dist/components/button/Button.js",
      "default": "./dist/components/button/Button.js"
    },
    "./text-field": {
      "types": "./dist/components/text-field/HeadlessTextField.d.ts",
      "import": "./dist/components/text-field/HeadlessTextField.js",
      "default": "./dist/components/text-field/HeadlessTextField.js"
    },
    "./switch": {
      "types": "./dist/components/switch/HeadlessSwitch.d.ts",
      "import": "./dist/components/switch/HeadlessSwitch.js",
      "default": "./dist/components/switch/HeadlessSwitch.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:styles": "node ./scripts/build-styles.ts",
    "build:dev": "node ./scripts/build.ts --skip-types",
    "build": "node ./scripts/build.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@kiskadee/css-build": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.9",
    "jsdom": "^28.1.0",
    "sass": "^1.100.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@kiskadee/core": "workspace:^"
  }
}
