{
  "name": "@kiskadee/react-headless",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tabs": {
      "types": "./src/tabs/HeadlessTabs.tsx",
      "import": "./src/tabs/HeadlessTabs.tsx"
    },
    "./button": {
      "types": "./src/button/Button.tsx",
      "import": "./src/button/Button.tsx"
    },
    "./text-field": {
      "types": "./src/text-field/HeadlessTextField.tsx",
      "import": "./src/text-field/HeadlessTextField.tsx"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16"
  }
}
