{
  "name": "@kiskadee/react-headless",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/HeadlessTabs.d.ts",
      "import": "./dist/components/tabs/HeadlessTabs.js",
      "default": "./dist/components/tabs/HeadlessTabs.js"
    },
    "./button": {
      "types": "./dist/components/button/Button.d.ts",
      "import": "./dist/components/button/Button.js",
      "default": "./dist/components/button/Button.js"
    },
    "./bottom-sheet": {
      "types": "./dist/components/bottom-sheet/BottomSheet.d.ts",
      "import": "./dist/components/bottom-sheet/BottomSheet.js",
      "default": "./dist/components/bottom-sheet/BottomSheet.js"
    },
    "./autocomplete": {
      "types": "./dist/components/autocomplete/Autocomplete.d.ts",
      "import": "./dist/components/autocomplete/Autocomplete.js",
      "default": "./dist/components/autocomplete/Autocomplete.js"
    },
    "./card": {
      "types": "./dist/components/card/Card.d.ts",
      "import": "./dist/components/card/Card.js",
      "default": "./dist/components/card/Card.js"
    },
    "./chip": {
      "types": "./dist/components/chip/HeadlessChip.d.ts",
      "import": "./dist/components/chip/HeadlessChip.js",
      "default": "./dist/components/chip/HeadlessChip.js"
    },
    "./icon": {
      "types": "./dist/components/icon/Icon.d.ts",
      "import": "./dist/components/icon/Icon.js",
      "default": "./dist/components/icon/Icon.js"
    },
    "./dropdown": {
      "types": "./dist/components/dropdown/Dropdown.d.ts",
      "import": "./dist/components/dropdown/Dropdown.js",
      "default": "./dist/components/dropdown/Dropdown.js"
    },
    "./menu": {
      "types": "./dist/components/menu/Menu.d.ts",
      "import": "./dist/components/menu/Menu.js",
      "default": "./dist/components/menu/Menu.js"
    },
    "./menu-tree": {
      "types": "./dist/components/menu-tree/MenuTree.d.ts",
      "import": "./dist/components/menu-tree/MenuTree.js",
      "default": "./dist/components/menu-tree/MenuTree.js"
    },
    "./select": {
      "types": "./dist/components/select/Select.d.ts",
      "import": "./dist/components/select/Select.js",
      "default": "./dist/components/select/Select.js"
    },
    "./progress": {
      "types": "./dist/components/progress/HeadlessProgress.d.ts",
      "import": "./dist/components/progress/HeadlessProgress.js",
      "default": "./dist/components/progress/HeadlessProgress.js"
    },
    "./text-field": {
      "types": "./dist/components/text-field/HeadlessTextField.d.ts",
      "import": "./dist/components/text-field/HeadlessTextField.js",
      "default": "./dist/components/text-field/HeadlessTextField.js"
    },
    "./switch": {
      "types": "./dist/components/switch/HeadlessSwitch.d.ts",
      "import": "./dist/components/switch/HeadlessSwitch.js",
      "default": "./dist/components/switch/HeadlessSwitch.js"
    },
    "./slider": {
      "types": "./dist/components/slider/HeadlessSlider.d.ts",
      "import": "./dist/components/slider/HeadlessSlider.js",
      "default": "./dist/components/slider/HeadlessSlider.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:styles": "node ./scripts/build-styles.ts",
    "build:dev": "node ./scripts/build.ts --skip-types",
    "build": "node ./scripts/build.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@kiskadee/css-build": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@kiskadee/core": "workspace:^"
  }
}
