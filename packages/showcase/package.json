{
  "name": "@kiskadee/showcase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx ./scripts/dev.ts",
    "build:components": "pnpm --filter @kiskadee/react-components run build",
    "build:artifacts": "pnpm --filter @kiskadee/web-builder run build-sync-generate",
    "build": "pnpm run build:components && pnpm run build:artifacts && next build",
    "start": "next start"
  },
  "dependencies": {
    "@kiskadee/core": "workspace:*",
    "@kiskadee/react-components": "workspace:*",
    "@kiskadee/react-headless": "workspace:*",
    "@kiskadee/runtime": "workspace:*",
    "@kiskadee/web-builder": "workspace:*",
    "next": "16.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sass": "^1.97.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
