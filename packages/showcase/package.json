{
  "name": "@kiskadee/showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.ts",
    "clean:dev": "pnpm --filter @kiskadee/icons run clean && pnpm --filter @kiskadee/react-headless run clean && pnpm --filter @kiskadee/react-components run clean && pnpm --filter @kiskadee/web-builder run clean",
    "dev:fresh": "pnpm run clean:dev && pnpm run dev",
    "build:fonts": "pnpm --filter @kiskadee/fonts run build",
    "build:icons": "pnpm --filter @kiskadee/icons run build",
    "build:headless": "pnpm --filter @kiskadee/react-headless run build",
    "build:components": "pnpm run build:fonts && pnpm run build:icons && pnpm run build:headless && pnpm --filter @kiskadee/react-components run build:self",
    "build:artifacts": "pnpm --filter @kiskadee/web-builder run build-sync-generate",
    "build": "pnpm run build:components && pnpm run build:artifacts && next build --webpack",
    "start": "next start"
  },
  "dependencies": {
    "@carbon/icons-react": "11.85.0",
    "@fluentui/react-icons": "2.0.334",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@kiskadee/brands": "workspace:*",
    "@kiskadee/core": "workspace:*",
    "@kiskadee/fonts": "workspace:*",
    "@kiskadee/icons": "workspace:*",
    "@kiskadee/react-components": "workspace:*",
    "@kiskadee/react-headless": "workspace:*",
    "@kiskadee/runtime": "workspace:*",
    "@kiskadee/web-builder": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "iconoir-react": "7.11.1",
    "lucide-react": "1.27.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "sass": "^1.100.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
