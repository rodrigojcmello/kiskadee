{
  "name": "Fluent",
  "prefix": "fm",
  "version": [
    2,
    0,
    0
  ],
  "author": "Microsoft",
  "breakpoints": {
    "bp:all": 0,
    "bp:sm:1": 320,
    "bp:sm:2": 360,
    "bp:sm:3": 400,
    "bp:md:1": 568,
    "bp:md:2": 768,
    "bp:md:3": 1024,
    "bp:lg:1": 1152,
    "bp:lg:2": 1312,
    "bp:lg:3": 1792,
    "bp:lg:4": 2432
  },
  "global": {
    "radius": "rounded"
  },
  "themeTokens": {
    "palettes": {
      "default": {
        "light": {
          "focusColor": [
            0,
            0,
            0,
            1
          ]
        },
        "dark": {
          "focusColor": [
            0,
            0,
            100,
            1
          ],
          "background": [
            0,
            0,
            12,
            1
          ]
        }
      }
    }
  },
  "components": {
    "button": {
      "elements": {
        "e1": {
          "name": "button",
          "decorations": {
            "borderStyle": "none"
          },
          "scales": {
            "paddingTop": {
              "s:sm:1": 2,
              "s:md:1": 6,
              "s:lg:1": 8
            },
            "paddingBottom": {
              "s:sm:1": 2,
              "s:md:1": 6,
              "s:lg:1": 8
            },
            "paddingLeft": {
              "s:sm:1": 8,
              "s:md:1": 12,
              "s:lg:1": 16
            },
            "paddingRight": {
              "s:sm:1": 8,
              "s:md:1": 12,
              "s:lg:1": 16
            },
            "borderRadius": {
              "rounded": {
                "s:sm:1": 4,
                "s:md:1": 4,
                "s:lg:1": 4
              },
              "pill": {
                "s:sm:1": 4,
                "s:md:1": 4,
                "s:lg:1": 4
              },
              "square": {
                "s:sm:1": 0,
                "s:md:1": 0,
                "s:lg:1": 0
              }
            }
          },
          "palettes": {
            "default": {
              "light": {
                "boxColor": {
                  "primary": {
                    "high": {
                      "rest": "#0F6CBD",
                      "hover": "#115EA3",
                      "focus": "#0F6CBD",
                      "pressed": "#0C3B5E",
                      "disabled": "#F0F0F0",
                      "selected": {
                        "rest": "#0F548C",
                        "hover": "#115EA3",
                        "pressed": "#0C3B5E"
                      }
                    }
                  }
                }
              },
              "dark": {
                "boxColor": {
                  "primary": {
                    "high": {
                      "rest": "#115EA3",
                      "hover": "#0F6CBD",
                      "focus": "#115EA3",
                      "pressed": "#0C3B5E",
                      "disabled": "#141414",
                      "selected": {
                        "rest": "#0F548C",
                        "hover": "#115EA3",
                        "pressed": "#0C3B5E"
                      }
                    }
                  }
                }
              }
            }
          },
          "effects": {
            "shadow": {
              "x": {
                "rest": 0,
                "hover": 0,
                "pressed": 0,
                "focus": 0,
                "disabled": 0
              },
              "y": {
                "rest": 2,
                "hover": 4,
                "pressed": 0,
                "focus": 4,
                "disabled": 0
              },
              "blur": {
                "rest": 6,
                "hover": 10,
                "pressed": 0,
                "focus": 10,
                "disabled": 0
              },
              "color": {
                "rest": "#00000047",
                "hover": "#00000059",
                "pressed": "#00000052",
                "focus": "#00000059",
                "disabled": "#0000"
              }
            }
          }
        },
        "e2": {
          "name": "button-text",
          "decorations": {
            "textWeight": "medium"
          },
          "palettes": {
            "default": {
              "light": {
                "textColor": {
                  "primary": {
                    "high": {
                      "rest": "#FFF",
                      "disabled": {
                        "ref": "#BDBDBD"
                      }
                    }
                  }
                }
              },
              "dark": {
                "textColor": {
                  "primary": {
                    "high": {
                      "rest": "#000",
                      "disabled": {
                        "ref": "#5C5C5C"
                      }
                    }
                  }
                }
              }
            }
          },
          "scales": {
            "textSize": {
              "s:sm:1": 12,
              "s:md:1": 14,
              "s:lg:1": 16
            },
            "textHeight": {
              "s:sm:1": 16,
              "s:md:1": 20,
              "s:lg:1": 22
            }
          }
        }
      }
    }
  }
}