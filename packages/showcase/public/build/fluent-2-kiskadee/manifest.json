{
  "key": "fluent-2-kiskadee",
  "displayName": "Fluent 2 by Kiskadee",
  "author": "Kiskadee",
  "schemaName": "Fluent",
  "version": "2.0.0",
  "segments": [
    "default",
    "dynamic"
  ],
  "themes": {
    "default": [
      "dark",
      "light"
    ],
    "dynamic": [
      "dark",
      "light"
    ]
  },
  "components": {
    "button": {
      "scale": {
        "s:sm:1": true,
        "s:md:1": true,
        "s:lg:1": true
      },
      "state": {
        "primary": {
          "vivid": {
            "rest": true,
            "hover": true,
            "focus": true,
            "pressed": true,
            "disabled": true,
            "selected": true
          }
        }
      }
    }
  }
}