      "body": [
        "IBM Plex Sans",
        "sans-serif"
      ]
    },
    "focus": {
      "width": 2,
      "offset": 1
    },
    "effects": {
      "activationFeedback": {
        "profile": "ripple",
        "origin": "pointer",
        "visual": {
          "layer": "overlay",
          "paint": "field",
          "tone": {
            "default": "subtle"
          }
        },
        "profiles": {
          "halo": {
            "animateSize": false,
            "size": 80,
            "durationToken": "interaction.instant",
            "fade": {
              "delayToken": "interaction.hold.short",
              "durationToken": "interaction.fade.long",
              "curveToken": "motion.standard.out"
            }
          }
        }
      }
    },
    "radius": "square"
  },
