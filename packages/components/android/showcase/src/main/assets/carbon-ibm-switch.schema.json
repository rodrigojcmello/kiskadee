            "activationFeedback": {
              "tone": {
                "subtle": {
                  "color": "#161616",
                  "opacity": 0.12
                },
                "vivid": {
                  "color": "#FFFFFF",
                  "opacity": 0.2
                }
              }
            }
          }
        }
      }
    }
