{
  "name": "@kiskadee/react-components",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./style": "./src/styles/style.kiskadee.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build:styles": "mkdir -p dist && sass --no-source-map src/styles/style.kiskadee.scss dist/style.kiskadee.css && postcss dist/style.kiskadee.css -o dist/style.kiskadee.css",
    "build": "pnpm run build:ts && pnpm run build:styles"
  },
  "author": "Rodrigo J C Mello",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "dependencies": {
    "@kiskadee/core": "workspace:^",
    "@kiskadee/react-headless": "workspace:^",
    "@kiskadee/web-builder": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.90.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.7",
    "typescript": "^5.9.2"
  }
}
