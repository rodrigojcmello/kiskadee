  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.ts",
    "build:js": "node ./scripts/build-js.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:styles": "node ./scripts/build-styles.ts",
    "dev:styles": "node ./scripts/watch-styles.ts",
    "build:dev:self": "node ./scripts/build.ts --skip-types",
    "build:self": "node ./scripts/build.ts",
    "build:dev": "pnpm --filter @kiskadee/react-headless run build:dev && pnpm run build:dev:self",
    "build": "pnpm --filter @kiskadee/react-headless run build && pnpm run build:self",
    "check:consumer-bundles": "node ./scripts/check-consumer-bundles.ts"
  },
  "author": "Rodrigo J C Mello",
  "license": "MIT",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@kiskadee/brands": "workspace:^",
    "@kiskadee/core": "workspace:^",
    "@kiskadee/icons": "workspace:^",
    "@kiskadee/react-headless": "workspace:^",
    "@kiskadee/runtime": "workspace:^",
    "@kiskadee/web-builder": "workspace:^",
    "motion": "^12.40.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@kiskadee/css-build": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "sass": "^1.100.0",
    "typescript": "^6.0.3"
  }
}
