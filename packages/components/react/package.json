{
  "name": "@kiskadee/react-components",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style": {
      "types": "./dist/style.kiskadee.css.d.ts",
      "default": "./dist/style.kiskadee.css"
    },
    "./style.css": {
      "types": "./dist/style.kiskadee.css.d.ts",
      "default": "./dist/style.kiskadee.css"
    },
    "./adaptive-button-menu": {
      "types": "./dist/components/AdaptiveButtonMenu/index.d.ts",
