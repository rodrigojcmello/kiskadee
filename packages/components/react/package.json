{
  "name": "@kiskadee/react-components",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style": "./dist/style.kiskadee.css",
    "./style.css": "./dist/style.kiskadee.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "clean": "tsx ./scripts/clean-dist.ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:styles": "tsx ./scripts/build-styles.ts",
    "dev:styles": "tsx ./scripts/watch-styles.ts",
    "build": "pnpm run clean && pnpm run build:ts && pnpm run build:styles"
  },
  "author": "Rodrigo J C Mello",
  "license": "MIT",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@kiskadee/core": "workspace:^",
    "@kiskadee/react-headless": "workspace:^",
    "@kiskadee/web-builder": "workspace:^",
    "motion": "^12.34.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@kiskadee/css-build": "workspace:^",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.7",
    "sass": "^1.90.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
