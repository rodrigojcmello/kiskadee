{
  "name": "@kiskadee/icons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kiskadee": {
      "types": "./dist/families/kiskadee/index.d.ts",
      "import": "./dist/families/kiskadee/index.js",
      "default": "./dist/families/kiskadee/index.js"
    },
    "./kiskadee/*": {
      "types": "./dist/families/kiskadee/*.d.ts",
      "import": "./dist/families/kiskadee/*.js",
      "default": "./dist/families/kiskadee/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "node ./scripts/build.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
